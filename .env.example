# ==============================================================================
# XAPYX ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to '.env' on the target server and fill in the secret values.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Django Core Settings
# ------------------------------------------------------------------------------
DJANGO_ENV=prod
DJANGO_SECRET_KEY=your-secure-django-secret-key-here
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=xapyx.com,betaa.xapyx.com,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://xapyx.com,https://betaa.xapyx.com
SESSION_COOKIE_AGE=2592000

# ------------------------------------------------------------------------------
# 2. MariaDB / MySQL Database
# ------------------------------------------------------------------------------
DB_NAME=xapyx
DB_USER=bn_xapyx
DB_PASSWORD=your-mariadb-user-password-here
DB_HOST=127.0.0.1
DB_PORT=3306
DB_SOCKET=/opt/bitnami/mariadb/tmp/mysql.sock
DB_CONN_MAX_AGE=60
DB_ROOT_PASSWORD=your-mariadb-root-password-here

# ------------------------------------------------------------------------------
# 3. Redis Cache & Celery
# ------------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379/1
CELERY_BROKER_URL=redis://127.0.0.1:6379/2
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/3

# ------------------------------------------------------------------------------
# 4. Amazon Web Services (AWS S3 Media Storage)
# ------------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_STORAGE_BUCKET_NAME=xapyx.com-media
AWS_S3_REGION_NAME=eu-west-1

# ------------------------------------------------------------------------------
# 5. Google Sign-In (Google Identity Services / OAuth 2.0)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ------------------------------------------------------------------------------
# 6. Firebase Realtime Database & Admin SDK
# ------------------------------------------------------------------------------
# Absolute path to your Firebase service account private key JSON file
FIREBASE_CREDENTIALS_PATH=/home/bitnami/xapyx_python/.firebase-admin.json

# Firebase Realtime Database URLs
FIREBASE_DB_URL=https://xapyx-notifications-default-rtdb.firebaseio.com
FIREBASE_CHAT_DB_URL=https://xapyx-chat-default-rtdb.firebaseio.com
FIREBASE_CHATROOM_DB_URL=https://xapyx-chatroom-chat-default-rtdb.firebaseio.com
FIREBASE_PAGES_DB_URL=https://xapyx-pages-messages-default-rtdb.firebaseio.com

# ------------------------------------------------------------------------------
# 7. Web Push Notifications (VAPID)
# ------------------------------------------------------------------------------
VAPID_PUBLIC_KEY=your-url-safe-base64-vapid-public-key
# Path to your private key PEM file (e.g., generated with ecdsa or web-push)
VAPID_PRIVATE_KEY_PATH=/home/bitnami/xapyx_python/vapid_private_key.pem
# Alternatively, inline private key string:
# VAPID_PRIVATE_KEY=
VAPID_ADMIN_EMAIL=mailto:admin@xapyx.com
